#!/sbin/openrc-run
# Confirm that this boot is healthy. After an update the new slot is only
# "on trial"; confirming it makes it the active slot in grubenv. If the
# health checks do not pass in time during a trial, the station reboots so
# GRUB can count the attempt and roll back.

description="Ingest Station boot confirmation"
pidfile=/run/ingest-bootok.pid

depend() {
	after ingest-data ingest-network ingest-console
}

start() {
	if grep -qE 'ingest_mode=(install|rescue)' /proc/cmdline; then
		einfo "Not an eMMC boot, nothing to confirm"
		return 0
	fi
	ebegin "Confirming boot in the background"
	start-stop-daemon --start --background --make-pidfile --pidfile "$pidfile" 		--exec /usr/local/bin/ingest-slot -- boot-ok --wait "${BOOTOK_TIMEOUT:-180}"
	eend $?
}

stop() {
	[ -f "$pidfile" ] && start-stop-daemon --stop --pidfile "$pidfile" 2>/dev/null
	return 0
}
