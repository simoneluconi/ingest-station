#!/sbin/openrc-run
# Ingest Station daemon: sources, imports, index, share. Restarted
# automatically if it ever exits.

description="Ingest Station daemon"
supervisor=supervise-daemon
command=/usr/local/sbin/ingestd
respawn_delay=2
respawn_max=0

depend() {
	need localmount
	# before the network: the daemon follows address changes by itself
	after ingest-data
	before ingest-bootok ingest-network
}

start_pre() {
	checkpath -d -m 0755 /run/ingest
}
